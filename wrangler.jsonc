{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "meka-studio",
  "compatibility_date": "2025-10-15",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "meka-studio"
    }
  ],
  // R2 incremental cache (ISR across isolates) can be enabled later:
  // "r2_buckets": [
  //   { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "meka-studio-cache" }
  // ],
  "vars": {
    "ADMIN_EMAILS": "methupadevinda@gmail.com",
    "SUPABASE_BUCKET": "media",
    "MAX_UPLOAD_MB": "50",
    "DATABASE_POOL_MAX": "2",
    "NEXTJS_ENV": "production"
  },
  "observability": {
    "enabled": true
  }
}
