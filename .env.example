# ── Site ──────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ── Supabase (Auth + Postgres + Storage) ──────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # anon / publishable key
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # SERVER ONLY – uploads, owner setup, team
SUPABASE_BUCKET=media
# Supabase Postgres → Settings → Database → Connection string
# Runtime uses the transaction pooler (6543); migrations use the session pooler (5432).
DATABASE_URL=
DATABASE_URL_MIGRATIONS=postgresql://postgres.xxxx:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres
MAX_UPLOAD_MB=50                                # raise on Supabase Pro (global limit applies)

# ── CMS access ────────────────────────────────────────
SETUP_TOKEN=change-me-long-random               # enables first-run owner creation at /admin/login
ADMIN_EMAILS=owner@your-domain.com              # auto-promoted to owner on first sign-in

# ── Mailgun ───────────────────────────────────────────
MAILGUN_API_KEY=key-xxxxxxxx
MAILGUN_DOMAIN=mg.your-domain.com
MAILGUN_REGION=us                               # us | eu
MAIL_FROM="Meka Studio <hello@mg.your-domain.com>"
MAIL_TO=                                        # optional fallback for booking alerts
MAILGUN_WEBHOOK_SIGNING_KEY=                    # optional – delivery tracking at /api/webhooks/mailgun
